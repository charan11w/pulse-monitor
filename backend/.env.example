# API settings. Local commands use the separate root .env generated by db:init.
# Existing values here are not overwritten or used as a database migration target.
# PORT must be an integer from 1 through 65535.
PORT=3000
# development, test, or production
NODE_ENV=development
# Exact browser origin: no trailing slash, paths or wildcard.
FRONTEND_ORIGIN=http://localhost:5173
# Optional manual demo settings; SDK key defaults to the generated root SEED_API_KEY.
DEMO_PORT=4000
DEMO_REQUESTS=30
DEMO_COLLECTOR_URL=http://127.0.0.1:3000/api/v1/telemetry/batch

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
}

model Project {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  environment String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  apiKeys          ApiKey[]
  telemetryEvents  TelemetryEvent[]
  metricAggregates MetricAggregate[]
}

model ApiKey {
  id        String    @id @default(uuid())
  projectId String
  name      String
  keyHash   String
  keyPrefix String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  revokedAt DateTime?

  project Project @relation(fields: [projectId], references: [id])
}

model TelemetryEvent {
  id           String   @id @default(uuid())
  projectId    String
  eventId      String   @unique
  service      String
  route        String
  method       String
  statusCode   Int
  responseTime Float
  environment  String
  requestId    String
  traceId      String?
  timestamp    DateTime

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([timestamp])
  @@index([projectId, timestamp])
  @@index([projectId, route])
  @@index([projectId, service])
}

model MetricAggregate {
  id             String   @id @default(uuid())
  projectId      String
  bucketStart    DateTime
  bucketSize     Int
  requestCount   Int
  errorCount     Int
  averageLatency Float
  p95            Float?
  p99            Float?

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId, bucketStart])
}
